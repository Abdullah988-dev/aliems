# MongoDB Connection (Optional in Testing/Demo Mode)
# Leave empty to run AliEMS in local fallback/mock-data mode.
# Set your MongoDB Atlas or self-hosted URI to switch immediately to live persistence.
MONGODB_URI=
MONGODB_DB_NAME=aliems

# Session Signing Secret (recommended for production Vercel deployment)
# Generate with: openssl rand -hex 32
AUTH_SECRET=aliems-dev-secret-change-in-production

# Gemini API Key (for Local Test Mode AI Bill Scanner)
GEMINI_API_KEY=

