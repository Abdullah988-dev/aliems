# MongoDB Connection (Optional in Testing/Demo Mode)
# Leave empty to run AliEMS in local fallback mode.
# In production, use a least-privilege Atlas user with TLS enabled.
MONGODB_URI=
MONGODB_DB_NAME=aliems

# Session Signing Secret (REQUIRED in production; >= 32 random hex chars)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Server-Side Gemini API Key (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Comma-separated allowed CORS origins for production (e.g., https://aliems.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
